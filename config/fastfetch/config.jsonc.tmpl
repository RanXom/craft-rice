{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.txt",
    "type": "file",
    "padding": {
      "top": 5,
      "left": 3,
      "right": 4,
    },
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────Software────────────────────┐",
    },
    {
      "type": "os",
      "key": "\uf17c OS",
      "keyColor": "yellow",
    },
    {
      "type": "kernel",
      "key": "│ ├\uf013",
      "keyColor": "yellow",
    },
    {
      "type": "bios",
      "key": "│ ├\uf2db",
      "keyColor": "yellow",
    },
    {
      "type": "shell",
      "key": "└ └\uf120",
      "keyColor": "yellow",
    },
    "break",
    {
      "type": "lm",
      "key": "\uf108",
      "keyColor": "blue",
    },
    {
      "type": "wm",
      "key": "│ ├\uf108",
      "keyColor": "blue",
    },
    {
      "type": "wmtheme",
      "key": "│ ├\uf1fc",
      "keyColor": "blue",
    },
    {
      "type": "terminal",
      "key": "└ └\uf120",
      "keyColor": "blue",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌───────────────────────OS───────────────────────┐",
    },
    {
      "type": "memory",
      "key": "  Memory ",
      "keyColor": "magenta",
      "format": "{used}/{total} ({percentage})",
    },
    {
      "type": "command",
      "key": "  OS Age ",
      "keyColor": "magenta",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
    },
    {
      "type": "uptime",
      "key": "  Uptime ",
      "keyColor": "magenta",
    },
    {
      "type": "datetime",
      "key": "  DateTime ",
      "keyColor": "magenta",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────┘",
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle",
    },
  ],
}
